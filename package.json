{
  "name": "nightrune",
  "version": "0.0.0",
  "private": true,
  "description": "A seeded fantasy card battler where runestones on a 4-position battle line strike head to head.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "play": "tsx cli/play.ts",
    "replay": "tsx cli/replay.ts",
    "scenes": "tsx scripts/scenes.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "factory": "tsx factory/run.ts",
    "factory:stats": "tsx factory/stats.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "vitest": "5.1.1"
  }
}
